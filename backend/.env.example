# 개발 기본값은 SQLite + 로컬 스토리지 + 모의 AI라서 아무것도 설정하지 않아도 돌아간다.

# --- DB ---
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.neon.tech/kidslog?sslmode=require
DATABASE_URL=sqlite:///./kidslog.db

# --- 인증 ---
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false            # 배포(HTTPS)에서는 true
CORS_ORIGINS=http://localhost:3000

# --- 스토리지: local | r2 ---
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=kidslog

# --- AI ---
# 키가 있으면 Claude, 없으면 모의 분석. AI_PROVIDER=mock 으로 강제 가능
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=300
FACE_BLUR_DEFAULT=false
